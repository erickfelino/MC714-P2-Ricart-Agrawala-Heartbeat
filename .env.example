# ==============================================================================
# CONFIGURAÇÃO DE IDENTIFICAÇÃO E REDE
# ==============================================================================

# ID único deste nó (1..N)
NODE_ID=1

# Lista completa de todos os nós do sistema no formato id@host:porta
PEERS=1@node1:5000,2@node2:5000,3@node3:5000

# Endereço do recurso compartilhado (Contador)
COUNTER_ADDR=counter:6000


# ==============================================================================
# DIRETÓRIOS E LOGS
# ==============================================================================

# Diretório onde os arquivos .jsonl de log serão salvos
LOG_DIR=/logs

# Identificador opcional do experimento
RUN_ID=exp-run-001


# ==============================================================================
# REPRODUTIBILIDADE E TEMPOS DE EXECUÇÃO (em Segundos)
# ==============================================================================

# Semente base para os geradores pseudoaleatórios (load e net)
SEED=1

# Duração da geração de carga a partir do início
DURATION_S=60

# Tempo de espera inicial antes de iniciar pedidos e monitoramento de falhas
START_DELAY_S=3

# Tempo de finalização (continua a responder heartbeats e solicitações antes de desligar)
DRAIN_S=5


# ==============================================================================
# CARGA E REGIÃO CRÍTICA (em Milissegundos)
# ==============================================================================

# Intervalo médio (distribuição exponencial) entre requisições da Região Crítica
REQ_INTERVAL_MS=200

# Tempo de permanência na Região Crítica (espera entre READ e WRITE)
CS_DURATION_MS=50


# ==============================================================================
# DETECTOR DE FALHAS / HEARTBEAT (em Milissegundos)
# ==============================================================================

# Intervalo (T) entre envios de mensagem HEARTBEAT
HB_INTERVAL_MS=500

# Tempo limite sem receber heartbeat para marcar um nó como SUSPECT
HB_TIMEOUT_MS=2000

# Período de checagem do detector de falhas
HB_CHECK_MS=100


# ==============================================================================
# SIMULAÇÃO DE REDE E TIMEOUTS (em Milissegundos)
# ==============================================================================

# Atraso fixo injetado em cada mensagem entre nós
NET_DELAY_MS=0

# Jitter aleatório máximo adicional (distribuição uniforme)
NET_JITTER_MS=0

# Timeout para conexões TCP e envios de mensagens
CONNECT_TIMEOUT_MS=1000